# Claude Code MCP (scripts/mcp.sh). Нусха: cp .env.mcp.example .env.mcp — .env.mcp git'га тушмайди.

# GitLab: Personal access token, scope "api" (gitlab.com → Edit profile → Access tokens)
GITLAB_TOKEN=
# readonly — фақат ўқиш; modify — issue/MR/коммит ҳам (лекин delete/move йўқ)
GITLAB_PERMISSION_MODE=modify

# PostgreSQL.
# Локал база (make db / make up), .env'даги POSTGRES_PASSWORD билан:
POSTGRES_MCP_URL=postgresql://santal:change-me@127.0.0.1:5432/santal
# Сервердаги база: SSH манзилини беринг ва URL'ни 15432-портга ўзгартиринг
# (паролни сервердаги /opt/santal/.env'дан олинг):
#   MCP_SSH=deploy@188.137.228.200
#   POSTGRES_MCP_URL=postgresql://santal:<сервер-пароли>@127.0.0.1:15432/santal
MCP_SSH=
# restricted — фақат ўқиш (production учун шу); unrestricted — ёзиш ҳам
POSTGRES_MCP_ACCESS=restricted
