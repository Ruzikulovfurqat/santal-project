# Ишлаб чиқариш дастури (app.py)
# HOST=0.0.0.0 — LAN'даги бошқа компьютерлар ҳам кира олади;
# HOST=127.0.0.1 — фақат шу сервернинг ўзидан. (Docker'да ҳамиша 0.0.0.0)
HOST=0.0.0.0
PORT=8642
# Кириш пароли: берилса, саҳифа ва API фақат шу логин/пароль билан очилади.
# Сервер интернетдан кўринса — АЛБАТТА тўлдиринг. Бўш бўлса — паролсиз (фақат ишончли LAN).
APP_USER=admin
APP_PASSWORD=
# Docker: дастур порти қайси IP'да очилади (0.0.0.0 — ҳамма интерфейс; масалан VPN IP'си)
APP_BIND=0.0.0.0

# PostgreSQL — дастур ҳам, бот ҳам шу битта базага уланади.
POSTGRES_USER=santal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=santal
# Docker'сиз ишлатилганда (make run) Postgres манзили.
# docker compose ичида автоматик "db" контейнерига уланади.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Ёки бутун уланишни битта қатор билан (берилса, юқоридагиларнинг ўрнига):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Телеграм бот (bot/bot.py)
# Бўш қолдирилса, бот ишга туширилмайди — фақат дастур ишлайди.
# Админ ботга /admin буйруғи билан шу токенни юбориб киради.
# Диллерларга кўрсатиладиган категориялар дастурдаги "Категориялар"дан олинади.
BOT_TOKEN=

# Webhook (ихтиёрий). Бўш бўлса — бот polling режимида ишлайди.
# Telegram янгиланишларни шу ОЧИҚ HTTPS манзилга юборади: <WEBHOOK_URL>/bot/webhook
# (охирига /bot/webhook ёзманг — у ўзи қўшилади).
WEBHOOK_URL=
# Webhook сўровини текшириш калити (бўш бўлса токендан ҳосил қилинади)
WEBHOOK_SECRET=
# Webhook қабул қиладиган сервер порти. Унда ФАҚАТ webhook бор, дастур (саҳифа/API) эмас.
# Cloudflare орқали: SSL "Flexible" бўлса 80; "Full"/"Full (strict)" бўлса 443 ва
# пастдаги сертификат (Cloudflare → SSL/TLS → Origin Server → Create Certificate).
WEBHOOK_PUBLIC_PORT=8443
# Ихтиёрий TLS: сертификат ва калит файллари (лойиҳа папкасига нисбатан, масалан certs/)
WEBHOOK_SSL_CERT=
WEBHOOK_SSL_KEY=
